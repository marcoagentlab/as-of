# Official runtime: npm, npm run dev, port 8080.
# Copy these into the process env. Do not commit a real key.

# API auth. Default if unset: DEMO_KEY
RWA_API_KEY=DEMO_KEY

# MCP client base. No trailing slash.
RWA_API_BASE=http://127.0.0.1:8080

# NAV freshness window in hours. Default 36 if unset or invalid.
RWA_FRESHNESS_HOURS=36
